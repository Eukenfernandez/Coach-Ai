
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    // Check if caller is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Check if caller owns this document
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Check if caller is the master admin account
    function isAdmin() {
      return isAuth() && request.auth.uid == 'MASTER_GOD_EUKEN';
    }

    // Check if the caller is a coach with an ACCEPTED relationship with this athlete
    function isAcceptedCoach(athleteId) {
      return isAuth() && exists(/databases/$(database)/documents/requests/$(request.auth.uid + '_' + athleteId))
        && get(/databases/$(database)/documents/requests/$(request.auth.uid + '_' + athleteId)).data.status == 'accepted';
    }

    // Check if {uid} is a coach with an ACCEPTED relationship with the caller
    // (the reverse direction: an athlete reading their coach's profile)
    function isMyAcceptedCoach(uid) {
      return isAuth() && exists(/databases/$(database)/documents/requests/$(uid + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/requests/$(uid + '_' + request.auth.uid)).data.status == 'accepted';
    }

    // The client may never self-assign the admin role; 'coach'/'athlete' are fine.
    function roleIsNotAdmin() {
      return request.resource.data.get(['profile', 'role'], '') != 'admin';
    }

    // Identity fields on a new profile must match the Auth record. Absent
    // fields are allowed so a profile-only merge on a missing doc still works.
    function identityMatchesAuth(uid) {
      let data = request.resource.data;
      let authEmail = request.auth.token.get('email', '').lower();
      return data.get('uid', uid) == uid
        && data.get('email', authEmail) == authEmail
        && data.get('username', authEmail) == authEmail;
    }

    // ...and can never be added, changed or removed afterwards. username used
    // to be freely writable, so anyone could set it to someone else's email.
    function identityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['uid', 'email', 'username']);
    }

    // ========== USER PROFILES ==========
    // Reads are restricted to the involved parties: profiles hold PII (name,
    // email, athletes list) and used to be enumerable by any signed-in user.
    // Coach lookup by email now happens through the sendCoachRequest callable.
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin() || isAcceptedCoach(uid) || isMyAcceptedCoach(uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && roleIsNotAdmin() && identityMatchesAuth(uid));
      allow update: if isAdmin() || (isOwner(uid) && roleIsNotAdmin() && identityUnchanged());
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ========== USER DATA (videos, plans, records) ==========
    match /userdata/{uid} {
      allow read: if isOwner(uid) || isAcceptedCoach(uid) || isAdmin();
      allow write: if isOwner(uid) || isAcceptedCoach(uid) || isAdmin();

      // Video subcollection. Clients may never claim quotaCounted:true —
      // only Cloud Functions mark an asset as already counted; otherwise a
      // direct write could skip the monthly quota.
      match /videos/{videoId} {
        allow read: if isOwner(uid) || isAcceptedCoach(uid) || isAdmin();
        allow create: if (isOwner(uid) || isAcceptedCoach(uid) || isAdmin())
          && request.resource.data.get('quotaCounted', false) != true;
        allow update: if (isOwner(uid) || isAcceptedCoach(uid) || isAdmin())
          && (request.resource.data.get('quotaCounted', false) != true
              || resource.data.get('quotaCounted', false) == true);
        allow delete: if isOwner(uid) || isAcceptedCoach(uid) || isAdmin();
      }

      // Plans subcollection (same quotaCounted guard)
      match /plans/{planId} {
        allow read: if isOwner(uid) || isAcceptedCoach(uid) || isAdmin();
        allow create: if (isOwner(uid) || isAcceptedCoach(uid) || isAdmin())
          && request.resource.data.get('quotaCounted', false) != true;
        allow update: if (isOwner(uid) || isAcceptedCoach(uid) || isAdmin())
          && (request.resource.data.get('quotaCounted', false) != true
              || resource.data.get('quotaCounted', false) == true);
        allow delete: if isOwner(uid) || isAcceptedCoach(uid) || isAdmin();
      }

      // Video intelligence context generated by backend
      match /videoContexts/{videoId} {
        allow read: if isOwner(uid) || isAcceptedCoach(uid) || isAdmin();
        allow write: if false;

        match /segments/{segmentId} {
          allow read: if isOwner(uid) || isAcceptedCoach(uid) || isAdmin();
          allow write: if false;
        }

        match /chatSessions/{sessionId} {
          allow read: if isOwner(uid) || isAcceptedCoach(uid) || isAdmin();
          allow write: if false;

          match /messages/{messageId} {
            allow read: if isOwner(uid) || isAcceptedCoach(uid) || isAdmin();
            allow write: if false;
          }
        }
      }
    }

    // ========== COACH-ATHLETE REQUESTS (canonical relationship) ==========
    // Creation happens ONLY via the sendCoachRequest Cloud Function: a client
    // used to be able to create a request with status 'accepted' in one write
    // and grant itself full access to any user's data.
    match /requests/{requestId} {
      // Only the two involved parties can read a request
      allow read: if isAuth() && (
        resource.data.coachId == request.auth.uid ||
        resource.data.athleteId == request.auth.uid ||
        resource.data.athleteEmail == request.auth.token.email
      );
      allow create: if false; // Only the sendCoachRequest Cloud Function
      // Status is the only mutable field. The athlete may answer a pending
      // request or leave an active one; a rejection is final until the coach
      // re-sends through sendCoachRequest, otherwise a removed athlete could
      // flip 'rejected' back to 'accepted' and undo the coach's revocation.
      // 'suspended' is server-only (coach over their plan's athlete limit).
      // The coach may only reject (cancel) — never accept on the athlete's behalf.
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          ((resource.data.athleteId == request.auth.uid ||
            resource.data.athleteEmail == request.auth.token.email)
            && ((resource.data.status == 'pending'
                  && request.resource.data.status in ['accepted', 'rejected'])
                || (resource.data.status in ['accepted', 'suspended']
                  && request.resource.data.status == 'rejected')))
          ||
          (resource.data.coachId == request.auth.uid
            && request.resource.data.status == 'rejected')
        );
      allow delete: if false;
    }

    // ========== QUOTA COUNTERS (server-managed, read-only for clients) ==========
    match /quota_counters/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Only Cloud Functions should write to this collection
      // Client writes are denied.
      allow write: if false;
    }

    // ========== SUBSCRIPTION & STRIPE (managed by extension + Cloud Functions) ==========
    // Subscription/payment docs are written exclusively by the Stripe
    // extension (Admin SDK). If the client could write them, it could forge
    // an active PREMIUM subscription — the server trusts these docs for tier.
    match /customers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // The resync flow deletes the mapping doc after a 'No such customer' error
      allow delete: if isOwner(uid) || isAdmin();
      allow create, update: if false;

      // The client creates checkout sessions; the extension fills in the URL.
      // The client may not pre-fill the extension's output fields: the app
      // opens `url` in the browser as soon as it appears.
      match /checkout_sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && !request.resource.data.keys().hasAny(['url', 'error', 'sessionId']);
        allow update, delete: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }

    // ========== ACCOUNT ENFORCEMENT (server-managed) ==========
    match /account_enforcement/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // ========== NOTIFICATIONS ==========
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if false; // Only Cloud Functions
    }

    // ========== AI ANALYSIS LOGS (server-managed) ==========
    match /ai_analysis_logs/{logId} {
      allow read: if false;
      allow write: if false; // Only Cloud Functions
    }
  }
}
