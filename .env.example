# Copia este fichero a .env.local (ignorado por git). Todas las variables son opcionales
# para arrancar en local. Tipos en vite-env.d.ts.

# URL pública de la app (deep links, retornos desde Stripe y navegador externo en móvil)
VITE_PUBLIC_APP_URL=https://coachai.es

# Clave PUBLICABLE de Stripe (pk_test_... en desarrollo). Nunca la secreta.
VITE_STRIPE_PUBLIC_KEY=

# Configuración web de Firebase. Hoy está embebida en svcs/storageService.ts;
# estas variables están reservadas para moverla aquí (ver docs/ARCHITECTURE.md → deuda).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# NO pongas aquí GEMINI_API_KEY: vive en Firebase Secrets y solo la leen las Cloud Functions.
#   firebase functions:secrets:set GEMINI_API_KEY
